# ---------- Database ----------
# Quick start (zero setup): SQLite file created automatically
DATABASE_URL=sqlite:///./pharmalab.db
# Local PostgreSQL (docker compose up -d):
# DATABASE_URL=postgresql+psycopg2://pharmalab:pharmalab@localhost:5432/pharmalab
# Azure SQL Database:
# DATABASE_URL=mssql+pyodbc://<user>:<password>@<server>.database.windows.net:1433/<db>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------- File storage ----------
# Leave empty to use the local ./uploads folder. Set to use Azure Blob Storage.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=lab-documents
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Demo data ----------
# true  = on first start with an EMPTY database, create the 5 demo accounts + sample data.
# Set to false in production (the demo accounts share a publicly known password).
AUTO_SEED=true
