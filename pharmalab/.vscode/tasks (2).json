{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Setup Backend Virtual Env & Dependencies",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "windows": {
        "command": "python -m venv venv && .\\venv\\Scripts\\pip install -r requirements.txt"
      },
      "linux": {
        "command": "python3 -m venv venv && ./venv/bin/pip install -r requirements.txt"
      },
      "osx": {
        "command": "python3 -m venv venv && ./venv/bin/pip install -r requirements.txt"
      },
      "problemMatcher": []
    },
    {
      "label": "2. Setup Frontend Node Packages",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "Start FastAPI Backend (:8000)",
      "type": "shell",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "windows": {
        "command": ".\\venv\\Scripts\\uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"
      },
      "linux": {
        "command": "./venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"
      },
      "osx": {
        "command": "./venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"
      },
      "problemMatcher": []
    },
    {
      "label": "Start React Vite Frontend (:5173)",
      "type": "shell",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "command": "npm run dev",
      "problemMatcher": []
    },
    {
      "label": "3. Start Full-Stack PharmaLab (Backend + Frontend)",
      "dependsOn": [
        "Start FastAPI Backend (:8000)",
        "Start React Vite Frontend (:5173)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
