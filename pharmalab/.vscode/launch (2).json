{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI Backend (Uvicorn :8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "React Frontend (Chrome :5173)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "Launch Full-Stack PharmaLab",
      "configurations": [
        "FastAPI Backend (Uvicorn :8000)",
        "React Frontend (Chrome :5173)"
      ]
    }
  ]
}
