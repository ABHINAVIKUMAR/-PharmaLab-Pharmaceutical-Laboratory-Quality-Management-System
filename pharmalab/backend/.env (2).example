# Application Settings
APP_NAME="PharmaLab QMS API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT Configuration
JWT_SECRET_KEY="CHANGE_THIS_TO_A_64_CHAR_HEX_SECRET_IN_PRODUCTION"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# For Phase 1-3 local boot before SQL Server setup, defaults to local SQLite.
# For Microsoft SQL Server / Azure SQL Database (Phase 4+):
# mssql+pyodbc://username:password@your-server.database.windows.net:1433/PharmaLabDB?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
DATABASE_URL="sqlite:///./pharmalab_dev.db"

# Microsoft Azure Blob Storage (Phase 10)
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME="pharmalab-documents"

# Frontend CORS Origin
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
